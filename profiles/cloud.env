# PROFILE: cloud — Claude Platform on AWS for everything. Current pre-project behavior.
# Use this for shipping. Convergence verdicts are trustworthy here.

export VSDD_PROFILE="cloud"

export CLAUDE_CODE_USE_ANTHROPIC_AWS=1
export AWS_REGION="us-east-1"
# ANTHROPIC_AWS_WORKSPACE_ID — sourced from .envrc.secrets before this profile loads

# Credential resolution, in order of preference:
#   1. Already present in the environment (e.g. exported by .envrc) — used as-is.
#   2. macOS Keychain service 'anthropic-aws-api-key'.
#
# NOTE (2026-08-04): the Keychain entry and the .envrc value are DIFFERENT keys
# (128 vs 132 chars). The .envrc one is the actively-exported, known-working key;
# the Keychain one appears stale. Nothing has been changed — resolving that is a
# credential decision for you to make. See RESEARCH.md §9.
if [ -z "${ANTHROPIC_AWS_API_KEY:-}" ]; then
  if _k=$(security find-generic-password -a "$USER" -s anthropic-aws-api-key -w 2>/dev/null); then
    export ANTHROPIC_AWS_API_KEY="$_k"
    unset _k
    echo "cloud profile: using Keychain key (may be stale — see comment above)" >&2
  else
    echo "cloud profile: no ANTHROPIC_AWS_API_KEY in env or Keychain." >&2
  fi
fi

# Local routing off — let Claude Code resolve aliases against the AWS provider.
unset ANTHROPIC_BASE_URL
unset ANTHROPIC_AUTH_TOKEN
unset ANTHROPIC_API_KEY
# 2026-08-18 human directive: judgment tier = Opus 4.8 on ALL profiles (was
# provider-default Opus 5). Disclosed Run-comparison condition change.
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-4-8"
unset ANTHROPIC_DEFAULT_SONNET_MODEL
unset ANTHROPIC_DEFAULT_HAIKU_MODEL
unset CLAUDE_CODE_SUBAGENT_MODEL
export CLAUDE_CODE_ATTRIBUTION_HEADER=0
