# PROFILE: local — frontier judgment, DGX Spark execution over Tailscale.
# The Spark-rehearsal profile: same shape as hybrid, but implementation and
# mechanical tiers run on the two shared DGX Spark nodes instead of LM Studio.
#
#   opus   -> Claude Opus 4.8 via AWS           (judgment agents + planners)
#   sonnet -> Qwen3-Coder-Next-int4 @ <node-name>   (implementer / test-writer / ...)
#   haiku  -> Gemma 4 12B QAT       @ <node-name>   (mechanical agents)
#
# TRANSLATION RISK: the Sparks are OpenAI-native, so LiteLLM translates
# Anthropic <-> OpenAI on these routes (unlike hybrid, where LM Studio speaks
# Anthropic natively). tool_use blocks are the known casualty class — run
# `scripts/litellm-gateway.sh test` and verify tool_call round-trips on BOTH
# spark routes before trusting this profile for factory work.
#
# CUDA caching NOTE: qwen3-coder-next is prefix-CACHEABLE on CUDA vLLM
# (unlike Metal — the reason it was retired from the hybrid roster). Run the
# Day-0 battery (3-call + fan-out + production-shape replay) against <node-name>
# before any measured run: this answers portability-brief §5 Q1.
#
# Tailscale mechanics (owner notes, 2026-08-18): IPs not MagicDNS; first call
# after idle may take seconds (gateway retries absorb it); node key expiry
# 2027-02-03 — not disabled, URLs die on lapse until re-auth.
#
# Requires: scripts/litellm-gateway.sh up  +  the tailnet share accepted on
# this machine (verify: tailscale ping <tailscale-peer-ip> — "no matching peer"
# means the share hasn't landed; accept it in the Tailscale admin console).

export VSDD_PROFILE="local"

export ANTHROPIC_BASE_URL="http://localhost:4100"
export ANTHROPIC_AUTH_TOKEN="vsdd-local-gateway"
export CLAUDE_CODE_ATTRIBUTION_HEADER=0
export ANTHROPIC_API_KEY=""

# LiteLLM route names from config/litellm.yaml, not raw model ids.
export ANTHROPIC_DEFAULT_OPUS_MODEL="judgment-primary"
export ANTHROPIC_DEFAULT_SONNET_MODEL="implementation-spark"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="mechanical-spark"

export CLAUDE_CODE_SUBAGENT_MODEL="inherit"

# AWS creds are consumed by LiteLLM (server side), not by Claude Code directly.
unset CLAUDE_CODE_USE_ANTHROPIC_AWS
unset CLAUDE_CODE_USE_BEDROCK
unset ANTHROPIC_MODEL
