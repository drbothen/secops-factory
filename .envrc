# VSDD PROFILE SWITCH — auto-loaded by direnv on `cd` into this directory.
# Run `direnv allow` after editing this file.
#
# This file is SECRET-FREE and safe to commit. Credentials live in .envrc.secrets
# (gitignored).
#
# Switch model backends with:
#     scripts/factory-profile local     # DGX Spark via Tailscale             (:4100)
#     scripts/factory-profile hybrid    # frontier judgment + local            (:4100)
#     scripts/factory-profile cloud     # all-frontier via AWS
#     direnv reload                     # apply, then restart claude
#
# Profiles are in profiles/*.env; the active one is named in .factory-profile.

# ---- non-secret AWS settings (used by the cloud + hybrid profiles) ----------
export AWS_REGION="us-east-1"
export ANTHROPIC_AWS_WORKSPACE_ID="wrkspc_013c8SxC8cMTttFTyDDPchwq"

# ---- secrets (gitignored; absent is tolerated, profiles fall back) ----------
if [ -f "$PWD/.envrc.secrets" ]; then
  # shellcheck disable=SC1091
  . "$PWD/.envrc.secrets"
fi

# ---- active profile, sourced LAST so it overrides everything above ----------
_vsdd_profile="hybrid"
if [ -f "$PWD/.factory-profile" ]; then
  _vsdd_profile="$(tr -d '[:space:]' < "$PWD/.factory-profile")"
fi

# Allowlist guard: reject path-traversal payloads in .factory-profile (SEC-006).
case "$_vsdd_profile" in
  local|hybrid|cloud) ;;
  *) echo "vsdd: unknown profile '${_vsdd_profile}' (must be local/hybrid/cloud); defaulting to hybrid" >&2
     _vsdd_profile="hybrid" ;;
esac

if [ -f "$PWD/profiles/${_vsdd_profile}.env" ]; then
  # shellcheck disable=SC1090
  . "$PWD/profiles/${_vsdd_profile}.env"
  echo "vsdd profile: ${_vsdd_profile}  ->  ${ANTHROPIC_BASE_URL:-AWS (provider default)}"
else
  echo "vsdd profile: '${_vsdd_profile}' not found in profiles/" >&2
fi
unset _vsdd_profile
