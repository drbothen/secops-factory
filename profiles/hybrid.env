# PROFILE: hybrid — frontier judgment, local execution. The recommended working profile.
#
#   opus   -> Claude Opus 4.8 via AWS (7 judgment agents + 4 promoted planners)
#             (2026-08-18 directive: was Opus 5 — route target changed in litellm.yaml)
#   sonnet -> Qwen3-Coder-30B-A3B local (implementer / test-writer / ...)
#             (2026-08-16 tier amendment: was Qwen3-Coder-Next — uncacheable on Metal)
#   haiku  -> Gemma 4 12B local       (mechanical agents)
#
# WHY A GATEWAY IS REQUIRED HERE:
# Claude Code sends every request to a single ANTHROPIC_BASE_URL. Alias env vars
# choose the model *name*, not the backend. Mixing cloud + local therefore needs
# one endpoint that fronts both — that is LiteLLM's only job in this design.
# (Translation is NOT needed; LM Studio speaks Anthropic natively.)
#
# Requires: scripts/litellm-gateway.sh up

export VSDD_PROFILE="hybrid"

export ANTHROPIC_BASE_URL="http://localhost:4100"
export ANTHROPIC_AUTH_TOKEN="vsdd-local-gateway"
export CLAUDE_CODE_ATTRIBUTION_HEADER=0
export ANTHROPIC_API_KEY=""

# These are LiteLLM route names from config/litellm.yaml, not raw model ids.
export ANTHROPIC_DEFAULT_OPUS_MODEL="judgment-primary"
export ANTHROPIC_DEFAULT_SONNET_MODEL="implementation-local"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="mechanical-local"

export CLAUDE_CODE_SUBAGENT_MODEL="inherit"

# AWS creds are consumed by LiteLLM (server side), not by Claude Code directly.
unset CLAUDE_CODE_USE_ANTHROPIC_AWS
unset CLAUDE_CODE_USE_BEDROCK
unset ANTHROPIC_MODEL
